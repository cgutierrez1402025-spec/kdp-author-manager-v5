{
    "name": "cgutierrez1402025-spec/kdp-project-v2",
    "type": "project",
    "description": "kdp-project-v2 - A Laravel based project",
    "license": "MIT",
    "authors": [
        {
            "name": "Carlos Gutierrez",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.3.53",
        "guzzlehttp/guzzle": "^7.15.2",
        "laravel/framework": "^12.61.1",
        "laravel/tinker": "^2.9",
        "livewire/livewire": "^3.5",
        "spatie/laravel-activitylog": "^4.12",
        "symfony/dom-crawler": "^7.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.4",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "larastan/larastan": "^3.10",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G --debug --no-progress",
        "format": "pint",
        "format:check": "pint --test",
        "quality": [
            "@composer validate --strict",
            "@composer audit",
            "@format:check",
            "@analyse",
            "@test"
        ],
        "test": "@php artisan test --compact",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
